// 多变量循环：RPN 超指令路径的地雷探测用例（SPEC D-03）
// 若有人让 RPN 真正生效，vm_executor.cpp:957-968 会把同一个 result
// 赋给所有「循环内被修改的变量」，这个用例会立刻变红。
//
// 用布尔断言而非 output(数字)：两边数字打印格式不同（3 vs 3.000000），
// 连 strings() 也不同（SPEC §3.5），只有布尔值和字符串是可移植的。
var n = 0;
var s = 0;
loop (n < 1000) {
    s = s + n;
    n = n + 1;
}
output(s == 499500);
output(n == 1000);
