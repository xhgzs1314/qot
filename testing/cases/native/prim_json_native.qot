// json 原语 native 化钉（）：encode/decode/valid/pretty 两侧同果。
// 键序：显式 dict_keys + arr_sort（QOT 字典在 native 是开放寻址表，遍历序 =
// 槽序；解释器是插入序 —— 登记定价 D-JSON-ORDER，需要稳定序就显式排序）。
var d = dict_new();
dict_set(d, "name", "ada");
dict_set(d, "score", 99.5);
dict_set(d, "age", 7);
dict_set(d, "ok", true);
dict_set(d, "nope", null);
var keys = dict_keys(d);
arr_sort(keys);
var parts = arr_new();
var i = 0;
loop (i < arr_len(keys)) {
    var k = arr_get(keys, i);
    arr_push(parts, "\"" + k + "\": " + json_encode(dict_get(d, k)));
    i += 1;
}
output("{" + str_join(parts, ", ") + "}");

var arr = arr_new();
arr_push(arr, 1);
arr_push(arr, 2.5);
arr_push(arr, "x\ty");
arr_push(arr, false);
arr_push(arr, null);
output(json_encode(arr));

var back = json_decode("{\"a\": 1, \"b\": [1, 2.5, true, null], \"c\": \"hi\"}");
output("a=" + int_to_str(dict_get(back, "a")));
var bb = dict_get(back, "b");
output("b1=" + num_to_str(arr_get(bb, 1), 3));
output("c=" + strings(dict_get(back, "c")));
output("valid=" + strings(json_valid("{\"x\": 1}")));
output("valid_bad=" + strings(json_valid("{oops}")));
output("pin-end");
