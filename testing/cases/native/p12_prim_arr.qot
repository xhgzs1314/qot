// P12 · P0-E 数组原语差分（CP-2）。高阶项 = 闭包回调（F1 落地的直接用户）。
var a = arr_new();
output(arr_len(a));
arr_push(a, 3);
arr_push(a, 1);
arr_push(a, 2);
output(arr_len(a));
output(arr_get(a, 0));
output(arr_get(a, 5));
output(arr_set(a, 1, 9));
output(arr_get(a, 1));
output(arr_set(a, 99, 1));
output(arr_pop(a));
output(arr_len(a));
var b = arr_from(["x", "y"]);
output(arr_get(b, 0));
arr_insert(a, 0, 7);
output(arr_len(a));
output(arr_get(a, 0));
output(arr_remove_at(a, 1));
output(arr_contains(a, 7));
output(arr_index_of(a, 7));
output(arr_index_of(a, 100));
output(arr_count(arr_from([1, 2, 1, 3, 1]), 1));
var s = arr_slice(arr_from([1, 2, 3, 4, 5]), 1, 4);
output(arr_len(s));
output(arr_join(s, ","));
var c = arr_concat(arr_from([1]), arr_from([2, 3]));
output(arr_len(c));
arr_reverse(c);
output(arr_join(c, "|"));
var u = arr_from([2, 1, 3, 1, 2]);
arr_sort(u);
output(arr_join(u, ","));
var m = arr_from(["b", "a", "c"]);
arr_sort(m);
output(arr_join(m, ","));
var mixed = arr_from([2, "a", 1]);
arr_sort(mixed);
output(arr_join(mixed, ","));
output(arr_join(arr_unique(arr_from([1, 2, 1, 3, 2])), ","));
var fl = arr_from([arr_from([1, 2]), arr_from([3]), 4]);
var flt = arr_flatten(fl);
output(arr_len(flt));
output(arr_get(flt, 2));
output(arr_sum(arr_from([1, 2, 3])));
output(arr_min(arr_from([4, 2, 9])));
output(arr_max(arr_from([4, 2, 9])));
output(arr_eq(arr_from([1, 2]), arr_from([1, 2])));
output(arr_eq(arr_from([1, 2]), arr_from([2, 1])));
var cp = arr_copy(arr_from([1]));
output(arr_get(cp, 0));
output(arr_join(arr_map(arr_from([1, 2, 3]), func(x) -> x * 2), ","));
output(arr_join(arr_filter(arr_from([1, 2, 3, 4]), func(x) -> x % 2 == 0), ","));
output(arr_reduce(arr_from([1, 2, 3]), func(acc, v) -> acc + v, 0));
var desc = arr_from([3, 1, 2]);
arr_sort_by(desc, func(x) -> 0 - x);
output(arr_join(desc, ","));
var bylen = arr_from(["ccc", "a", "bb"]);
arr_sort_by(bylen, func(x) -> str_len(x));
output(arr_join(bylen, ","));
