// P10 · P0-B 字符串原语差分（CP-2）
// 规约：testing/cases 与 golden 均为 native 口径；oracle 侧（解释器）由
// test_primitive_oracle_diff.py 做逐 token 数字归一对比（归一规则写在该测试里）。
// 注意 S-14：数字样字符串字面量会被定价吃掉 —— 本文件全部用字母表。
// 注意 D-10：空串字面量 "" 在装载层规范化为 null（既有定价）—— 空串一律
// 用 str_slice 派生（原语产物是真 QStr ""，两侧一致）。
var emp = str_slice("abc", 9, 9);
output(str_len("hello"));
output(str_len(emp));
output(str_empty(emp));
output(str_empty("x"));
output(str_slice("abcdef", 1, 4));
output(str_slice("abcdef", 3, 100));
output(str_slice("abcdef", 4, 2));
output(str_byte_at("ABC", 0));
output(str_byte_at("ABC", 2));
output(str_byte_at("ABC", 9));
output(str_find("hello world", "world", 0));
output(str_find("hello world", "o", 5));
output(str_find("hello world", "xyz", 0));
output(str_rfind("a/b/c", "/"));
output(str_contains("hello", "ell"));
output(str_contains("hello", "ellp"));
output(str_starts_with("hello", "he"));
output(str_ends_with("hello", "lo"));
output(str_count("aXbXcX", "X"));
output(str_join(arr_from(["a", "b", "c"]), "-"));
output(str_replace("a-b-c", "-", "+"));
output(str_replace_n("a-a-a", "a", "b", 2));
output(str_upper("aBc1"));
output(str_lower("aBc1"));
output(str_trim("  hi  "));
output(str_ltrim("  hi  "));
output(str_rtrim("  hi  "));
output(str_pad_left("id", 5, "0"));
output(str_pad_right("id", 5, "."));
output(str_pad_left("abcdef", 3, "0"));
output(str_repeat("ab", 3));
output(str_repeat("ab", 0));
output(str_reverse("abc"));
output(str_cmp("a", "b"));
output(str_cmp("b", "a"));
output(str_cmp("a", "a"));
output(str_cmp("ab", "abc"));
output(str_eq_ignore_case("HeLLo", "hello"));
output(str_eq_ignore_case("HeLLo", "hellp"));
output(str_index_of_any("hello", "lo"));
output(str_index_of_any("hello", "xyz"));
output(str_starts_with_any("img.png", arr_from(["jpg", "png"])));
output(str_starts_with_any("img.png", arr_from(["jpg", "gif"])));
output(str_format("%s-%d-%f", "x", 42, 1.5));
output(str_format("100%%"));
output(str_format("%s"));
output(char_len("hello"));
output(char_slice("hello", 1, 3));
output(char_at("hello", 1));
output(char_at("hello", 9));
output(char_index_byte("hello", 2));
output(char_index_byte("héllo", 2));
output(char_upper("hello"));
output(char_lower("WORLD"));
output(str_utf8_valid("hello"));
output(str_utf8_valid("ok"));
output(str_hash("qot"));
output(str_split("a,b,,c", ","));
output(str_split("abc", emp));
output(str_split_lines("a\nb\n\n"));
output(str_split_n("a-b-c-d", "-", 2));
