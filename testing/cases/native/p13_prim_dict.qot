// P13 · P0-F 字典原语差分（CP-2）。不直接打印整字典：
// native 槽序与解释器插入序在删除后可能不同（已登记差异），差分只对
// 键值访问与长度。
var d = dict_new();
output(dict_len(d));
dict_set(d, "a", 1);
dict_set(d, "b", 2);
output(dict_len(d));
output(dict_get(d, "a"));
output(dict_get_or(d, "zz", 99));
output(dict_get_or(d, "a", 99));
output(dict_has(d, "b"));
output(dict_has(d, "zz"));
var e = dict_from([["k", 5], ["m", 6]]);
output(dict_get(e, "k"));
var ks = dict_keys(e);
output(arr_len(ks));
output(arr_get(ks, 0));
var vs = dict_values(e);
output(arr_len(vs));
output(arr_get(vs, 0));
var its = dict_items(e);
output(arr_len(its));
var it0 = arr_get(its, 0);
output(arr_get(it0, 0));
output(arr_get(it0, 1));
output(dict_del(d, "a"));
output(dict_has(d, "a"));
output(dict_del(d, "a"));
output(dict_len(d));
output(dict_clear(d));
output(dict_len(d));
var cp = dict_copy(e);
output(dict_get(cp, "m"));
var mg = dict_merge(e, cp);
output(dict_len(mg));
output(dict_get(mg, "k"));
output(dict_update(e, cp));
output(dict_len(e));
var inv = dict_invert(e);
output(dict_has(inv, num_to_str(5)));
output(dict_get(inv, num_to_str(5)));
var nested = dict_new();
output(dict_set_path(nested, "a.b.c", 7));
output(dict_get_path(nested, "a.b.c"));
output(dict_get_path(nested, "a.b.x"));
var sub = dict_get_path(nested, "a.b");
output(dict_len(sub));
output(dict_set_path(nested, "a.b", 1));
output(dict_get_path(nested, "a.b.c"));
output(dict_get_path(nested, "a"));
