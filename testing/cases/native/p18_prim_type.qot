// P18 · P0-K 类型与错误原语差分（P0.2）。
// type_of = type/gtypes 分歧的统一目标（§4.15 判例 6）。句柄的
// 「数字型固有模糊性」（§4.0）在本用例里用「先开后关」的时序钉住。
output(type_of(1));
output(type_of(1.5));
output(type_of("a"));
output(type_of(true));
output(type_of(false));
output(type_of([1, 2]));
output(type_of(dict_new()));
output(type_of(null));
output(type_of(err(1)));
output(type_of(err()));
var g = func(x) -> x + 1;
output(type_of(g));
output(type_is(1, "number"));
output(type_is("a", "string"));
output(type_is(true, "boolean"));
output(type_is([1], "array"));
output(type_is(dict_new(), "dict"));
output(type_is(null, "null"));
output(type_is(err(0), "error"));
output(type_is(g, "function"));
output(type_is(1, "string"));
output(type_is(null, "null"));
output(is_null(null));
output(is_null(0));
output(is_null(""));
output(is_array([1]));
output(is_array("a"));
output(is_dict(dict_new()));
output(is_dict([1]));
output(is_string("a"));
output(is_string(1));
output(is_bool(true));
output(is_bool(1));
output(to_num("42"));
output(to_num(" 3.5 "));
output(to_num("-7"));
output(to_num("x"));
output(to_num(str_slice("abc", 0, 0)));
output(to_num("1.5e2"));
output(to_num(true));
output(to_num(false));
output(to_num(null));
output(to_num([1]));
output(to_bool(0));
output(to_bool(1));
output(to_bool(-2));
output(to_bool(""));
output(to_bool("a"));
output(to_bool(null));
output(to_bool([1]));
output(to_bool(dict_new()));
output(to_bool(err(0)));
output(arr_len(to_array(5)));
output(arr_get(to_array("v"), 0));
output(is_null(to_array(null)));
output(type_of(to_array(1.25)));
var tmp = "p18_probe_tmp.txt";
var fh = file_open(tmp, "w");
output(is_handle(fh));
output(type_of(fh));
output(type_is(fh, "handle"));
output(file_close(fh));
output(is_handle(fh));
output(type_of(fh));
file_remove(tmp);
