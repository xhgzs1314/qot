// P14 · P0-A 文件与路径原语差分（CP-2）。
// 纪律：自建自清（测试目录 p14tmp 留在 cwd 下，用完即删）；
// 不打印 mtime 绝对值（机器相关），只打印 >0 判定。
var dir = "p14tmp";
output(dir_mkdirs(path_join(dir, "sub")));
var f = path_join(dir, "hello.txt");
var h = file_open(f, "w");
output(handle_valid(h));
output(file_write(h, "line1\nline2"));
output(file_close(h));
output(handle_valid(h));
output(file_exists(f));
var st = file_stat(f);
output(dict_get(st, "size"));
output(dict_get(st, "is_file"));
output(dict_get(st, "is_dir"));
output(file_mtime(f) > 0);
var r = file_open(f, "r");
output(file_read_all(r));
output(file_seek(r, 0, 0));
output(file_read(r, 5));
output(file_tell(r));
output(file_seek(r, 0, 2));
output(file_tell(r));
output(file_close(r));
output(file_exists(f));
output(file_copy(f, path_join(dir, "copy.txt")));
var ls = dir_list(dir);
output(arr_len(ls));
output(arr_get(ls, 0));
output(path_join("a", "b", "c.txt"));
output(path_dirname("a/b/c.txt"));
output(path_basename("a/b/c.txt"));
output(path_ext("a/b/c.txt"));
output(path_stem("a/b/c.txt"));
output(path_normalize("a//b/./c/../d"));
output(path_normalize("/a/../b"));
output(path_is_absolute("/x"));
output(path_is_absolute("x/y"));
output(path_is_file(f));
output(path_is_dir(dir));
output(file_rename(path_join(dir, "copy.txt"), path_join(dir, "moved.txt")));
output(file_exists(path_join(dir, "moved.txt")));
output(file_remove(path_join(dir, "moved.txt")));
output(file_remove(f));
output(dir_remove(path_join(dir, "sub")));
output(dir_remove(dir));
output(file_exists(dir));
output(file_remove("no_such_file.txt"));
output(file_open("no_such_dir/x.txt", "r"));
