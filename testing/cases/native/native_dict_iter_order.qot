// E1（字典槽压缩）的回归钉：**字典迭代顺序（槽序）逐行钉死**。
//
// 为什么必须钉：native 的字典是开放寻址扁平表，迭代顺序 = 槽数组下标序，
// 由「哈希 → 桶位 → 探测序列」唯一决定。任何改哈希宽度 / 改步进 / 改放置规则
// 的结构改动都会挪动槽位 —— 这是**用户可观察语义**（dict_keys / for-in 的
// 输出顺序），不许借「性能优化」的名义悄悄改掉。上一轮（M-PERF 收尾）的双
// 哈希步进改动就已经踩在这个面上，当时没有任何用例看守它。
//
// 负载刻意造两组、共 45 个键，远超初始 cap=8，强制发生多次 rehash 与探测
// 冲突，让顺序对布局真正敏感：
//   * 第一组 24 个长键（"k0.000000" … "k23.000000"，≥10B）→ 走**外部借用**
//     键（k.ext），钉住「槽 + 键缓冲」两段布局；
//   * 第二组 21 个 1 字符短键（"a"…"t" + "z"）→ 走**键内联**（≤8B 进槽），
//     钉住内联分支；同时也是 1 字符静态驻留串（M-PERF 收尾四）当键的路径。
//
// 口径说明（R5）：本用例 runs_on='native' —— native 是唯一产品形态，字典
// 槽序是 native 自己的表示细节（VM 用 qot_flatdict.h 的另一套布局，解释器
// 用 Python dict），跨引擎一致在这个面上既无意义也不可得。VM 已冻结（§8.7），
// 不为它新增用例。
var m = &< "z": 0 >&;
var i = 0;
loop (i < 24) {
    m["k" + strings(i)] = i;
    i = i + 1;
}
var ks = dict_keys(m);
output(glen(ks));
var q = 0;
loop (q < glen(ks)) {
    output(ks[q] + " -> " + strings(m[ks[q]]));
    q = q + 1;
}

var base = "abcdefghijklmnopqrst";
var m2 = &< "z": 0 >&;
var j = 0;
loop (j < 20) {
    m2[base[j]] = j;
    j = j + 1;
}
var ks2 = dict_keys(m2);
output(glen(ks2));
var r = 0;
loop (r < glen(ks2)) {
    output(ks2[r] + " -> " + strings(m2[ks2[r]]));
    r = r + 1;
}
