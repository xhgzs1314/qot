// F2 try/catch/throw：基本路径 + 重抛 + 返回值
output("before");
try {
    output("in-try");
    throw "boom";
} catch (e) {
    output("caught");
    output(e);
}
output("after");
try {
    try {
        throw "inner";
    } catch (e) {
        output("inner-caught");
        throw e;
    }
} catch (e2) {
    output("outer-caught");
    output(e2);
}
number_t func f() {
    try {
        return 7;
    } catch (e) {
        return -1;
    }
}
output(f());
try {
    throw 42;
} catch (num) {
    output(num + 1);
}
