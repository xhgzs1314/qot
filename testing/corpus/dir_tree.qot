// 语料线 · 10 目录树打印（建临时结构 → 递归遍历 → ASCII 树）
// 任务画像：给文档生成目录结构图。状态：✅ 可运行。
var root = "testing/.artifacts/corpus_tree";
dir_remove(root);
dir_mkdirs(root + "/src/core");
dir_mkdirs(root + "/src/util");
dir_mkdirs(root + "/docs");
var f = file_open(root + "/README.md", "w");
file_write(f, "# demo");
file_close(f);
f = file_open(root + "/src/core/engine.qot", "w");
file_write(f, "// engine");
file_close(f);
f = file_open(root + "/src/util/str.qot", "w");
file_write(f, "// str");
file_close(f);

number_t func walk(path, indent) {
    var names = dir_list(path);
    var i = 0;
    loop (i < arr_len(names)) {
        var nm = arr_get(names, i);
        var child = path + "/" + nm;
        if (path_is_dir(child)) {
            output(indent + nm + "/");
            walk(child, indent + "  ");
        } else {
            output(indent + nm);
        }
        i += 1;
    }
    return 0;
}

output("corpus_tree/");
walk(root, "  ");
dir_remove(root);
