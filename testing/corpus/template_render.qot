// 语料线 · 06 迷你模板引擎（{{name}} 占位符替换）
// 任务画像：给批量用户生成通知邮件。状态：✅ 可运行。
number_t func render(tpl, vars, names) {
    var out = tpl;
    var i = 0;
    loop (i < arr_len(names)) {
        var k = arr_get(names, i);
        var ph = "{{" + k + "}}";
        out = str_replace(out, ph, strings(dict_get(vars, k)));
        i += 1;
    }
    return out;
}

var tpl = "Hi {{name}}, your order {{id}} ships to {{city}}. Total: {{total}}.";
var vars = &< "name": "Ada", "id": "A-1024", "city": "Hangzhou", "total": "42.50" >&;
var names = arr_new();
arr_push(names, "name");
arr_push(names, "id");
arr_push(names, "city");
arr_push(names, "total");
output(render(tpl, vars, names));
