// 语料线 · 12 日期区间报表（time_parse/strftime + 逐日汇总）
// 任务画像：按天聚合访问量。状态：✅ 可运行。
var rows = ",120\n";
rows = rows + ",80\n";
rows = rows + ",200\n";
rows = rows + ",55\n";
rows = rows + ",45\n";

var lines = str_split_lines(rows);
var by_day = dict_new();
var i = 0;
loop (i < arr_len(lines)) {
    var row = str_split(arr_get(lines, i), ",");
    var day = arr_get(row, 0);
    var hits = str_to_num(arr_get(row, 1));
    dict_set(by_day, day, dict_get_or(by_day, day, 0) + hits);
    i += 1;
}
var days = arr_sort(dict_keys(by_day));
output("day         hits");
i = 0;
loop (i < arr_len(days)) {
    var d = arr_get(days, i);
    output(d + "  " + str_pad_left(int_to_str(dict_get(by_day, d)), 5, " "));
    i += 1;
}
