// 语料线 · 09 CSV → JSON 转换器（表头驱动的行对象化）
// 任务画像：把导出的 CSV 喂给下游 JSON API。状态：✅ 两侧可跑
// （json_encode 已 native 化，）。键序显式排序（D-JSON-ORDER）。
var csv = "id,name,score\n";
csv = csv + "1,ada,99.5\n";
csv = csv + "2,lin,87.25\n";
csv = csv + "3,sam,72\n";

var lines = str_split_lines(csv);
var header = str_split(arr_get(lines, 0), ",");
var out = arr_new();
var i = 1;
loop (i < arr_len(lines)) {
    var row = str_split(arr_get(lines, i), ",");
    var obj = dict_new();
    var j = 0;
    loop (j < arr_len(header)) {
        var h = arr_get(header, j);
        var v = arr_get(row, j);
        if (num_is_valid(v)) {
            dict_set(obj, h, str_to_num(v));
        } else {
            dict_set(obj, h, v);
        }
        j += 1;
    }
    // 键序显式化（native 字典遍历序 = 槽序，与解释器插入序不同 → 排序两侧同果）
    var ks = dict_keys(obj);
    arr_sort(ks);
    var parts = arr_new();
    var j2 = 0;
    loop (j2 < arr_len(ks)) {
        var kk = arr_get(ks, j2);
        arr_push(parts, "\"" + kk + "\": " + json_encode(dict_get(obj, kk)));
        j2 += 1;
    }
    arr_push(out, "{" + str_join(parts, ", ") + "}");
    i += 1;
}
i = 0;
loop (i < arr_len(out)) {
    output(arr_get(out, i));
    i += 1;
}
output("converted " + int_to_str(arr_len(out)) + " rows");
