// 语料线 · 22 环境变量审计（存在性 + 形状检查，输出结构不输出机密值）
// 任务画像：部署前置检查。状态：✅ 可运行（只查存在性，不打印值）。
var required = arr_new();
arr_push(required, "PATH");
var optional = arr_new();
arr_push(optional, "QOT_MAX_DEPTH");
arr_push(optional, "QOT_TIMEOUT_MS");

var report = arr_new();
var i = 0;
loop (i < arr_len(required)) {
    var k = arr_get(required, i);
    var v = env_get(k);
    if (is_null(v)) {
        arr_push(report, "MISSING required: " + k);
    } else {
        arr_push(report, "ok required: " + k + " (len=" + int_to_str(str_len(strings(v))) + ")");
    }
    i += 1;
}
i = 0;
loop (i < arr_len(optional)) {
    var k = arr_get(optional, i);
    var v = env_get(k);
    if (is_null(v)) {
        arr_push(report, "absent optional: " + k);
    } else {
        arr_push(report, "ok optional: " + k + " (len=" + int_to_str(str_len(strings(v))) + ")");
    }
    i += 1;
}
i = 0;
loop (i < arr_len(report)) {
    output(arr_get(report, i));
    i += 1;
}
