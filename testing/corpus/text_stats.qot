// 语料线 · 11 文本统计（行/词/字符/UTF-8 字符数/最长行）
// 任务画像：编辑器状态栏与文本体检。状态：✅ 可运行。
var text = "QOT 是一门小型语言\n";
text = text + "corpus line two\n";
text = text + "第三行 longer line here\n";
text = text + "\n";
text = text + "end";

var lines = str_split_lines(text);
var word_count = 0;
var longest = "";
var i = 0;
loop (i < arr_len(lines)) {
    var ln = arr_get(lines, i);
    if (str_len(ln) > str_len(longest)) {
        longest = ln;
    }
    var words = str_split(ln, " ");
    word_count += arr_len(words);
    i += 1;
}
output("lines        : " + int_to_str(arr_len(lines)));
output("words        : " + int_to_str(word_count));
output("bytes        : " + int_to_str(str_len(text)));
output("utf8 chars   : " + int_to_str(utf8_char_count(text)));
output("longest line : " + longest);
