// 语料线 · 15 矩阵乘法（嵌套数组 + 三重循环 + 行列式）
// 任务画像：小程序里的几何/统计计算。状态：✅ 可运行。
number_t func mat_mul(a, b) {
    var n = arr_len(a);
    var out = arr_new();
    var i = 0;
    loop (i < n) {
        var row = arr_new();
        var j = 0;
        loop (j < n) {
            var acc = 0;
            var k = 0;
            loop (k < n) {
                acc += arr_get(arr_get(a, i), k) * arr_get(arr_get(b, k), j);
                k += 1;
            }
            arr_push(row, acc);
            j += 1;
        }
        arr_push(out, row);
        i += 1;
    }
    return out;
}

number_t func det2(m) {
    return arr_get(arr_get(m, 0), 0) * arr_get(arr_get(m, 1), 1) -
           arr_get(arr_get(m, 0), 1) * arr_get(arr_get(m, 1), 0);
}

var a = arr_new();
var row_a0 = arr_new();
arr_push(row_a0, 1); arr_push(row_a0, 2);
arr_push(a, row_a0);
var row_a1 = arr_new();
arr_push(row_a1, 3); arr_push(row_a1, 4);
arr_push(a, row_a1);
var b = arr_new();
var row_b0 = arr_new();
arr_push(row_b0, 2); arr_push(row_b0, 0);
arr_push(b, row_b0);
var row_b1 = arr_new();
arr_push(row_b1, 1); arr_push(row_b1, 2);
arr_push(b, row_b1);

var c = mat_mul(a, b);
output("[ " + int_to_str(arr_get(arr_get(c, 0), 0)) + " " + int_to_str(arr_get(arr_get(c, 0), 1)) + " ]");
output("[ " + int_to_str(arr_get(arr_get(c, 1), 0)) + " " + int_to_str(arr_get(arr_get(c, 1), 1)) + " ]");
output("det(a) = " + int_to_str(det2(a)));
