// 语料线 · 20 购物车结算（明细/合计/满减规则）
// 任务画像：电商小程序的核心页。状态：✅ 可运行。
// 【缺口备注】想做"make_cart() 返回带 add/total 两个闭包的容器"——当前闭包
// 是 &f 函数引用 + 词法捕获（单值形态），无多返回值/对象容器（F4 类的前身
// 需求，见  G-05）。
var items = arr_new();

number_t func cart_add(name, price, qty) {
    arr_push(items, &< "name": name, "price": price, "qty": qty >&);
    return 0;
}

number_t func cart_total() {
    var t = 0;
    var i = 0;
    loop (i < arr_len(items)) {
        var it = arr_get(items, i);
        t += dict_get(it, "price") * dict_get(it, "qty");
        i += 1;
    }
    return t;
}

number_t func checkout() {
    var total = cart_total();
    var discount = 0;
    if (total >= 300) { discount = 60; }
    else {
        if (total >= 150) { discount = 25; }
    }
    return total - discount;
}

cart_add("keyboard", 199, 1);
cart_add("cable", 19.9, 2);
cart_add("mouse", 89, 1);

var i = 0;
loop (i < arr_len(items)) {
    var it = arr_get(items, i);
    output(str_pad_right(dict_get(it, "name"), 10, " ") +
           " x" + int_to_str(dict_get(it, "qty")) +
           "  " + num_to_str(dict_get(it, "price") * dict_get(it, "qty"), 2));
    i += 1;
}
output("subtotal: " + num_to_str(cart_total(), 2));
output("discount: " + num_to_str(cart_total() - checkout(), 2));
output("payable : " + num_to_str(checkout(), 2));
