// 语料线 · 16 快排 + 二分查找（递归 + 分治）
// 任务画像：经典算法落地（排序大表 + 查找）。状态：✅ 可运行。
number_t func qsort(a) {
    if (arr_len(a) <= 1) { return a; }
    var pivot = arr_get(a, 0);
    var lo = arr_new();
    var hi = arr_new();
    var i = 1;
    loop (i < arr_len(a)) {
        if (arr_get(a, i) < pivot) {
            arr_push(lo, arr_get(a, i));
        } else {
            arr_push(hi, arr_get(a, i));
        }
        i += 1;
    }
    var out = arr_new();
    var l = qsort(lo);
    i = 0;
    loop (i < arr_len(l)) { arr_push(out, arr_get(l, i)); i += 1; }
    arr_push(out, pivot);
    var h = qsort(hi);
    i = 0;
    loop (i < arr_len(h)) { arr_push(out, arr_get(h, i)); i += 1; }
    return out;
}

number_t func bsearch(a, x) {
    var lo = 0;
    var hi = arr_len(a) - 1;
    loop (lo <= hi) {
        var mid = lo + int_div(hi - lo, 2);
        var v = arr_get(a, mid);
        if (v == x) { return mid; }
        if (v < x) { lo = mid + 1; }
        else { hi = mid - 1; }
    }
    return -1;
}

var data = arr_new();
arr_push(data, 42); arr_push(data, 7); arr_push(data, 19);
arr_push(data, 73); arr_push(data, 1); arr_push(data, 55);
arr_push(data, 8); arr_push(data, 33);
var sorted = qsort(data);
output("sorted: " + arr_join(sorted, ","));
output("find 55 at " + int_to_str(bsearch(sorted, 55)));
output("find 99 at " + int_to_str(bsearch(sorted, 99)));
