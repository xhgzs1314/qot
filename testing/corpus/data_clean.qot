// 语料线 · 04 数据清洗管道（去空行 → trim → 大小写归一 → 去重 → 排序）
// 任务画像：把脏的用户标签列表清成规范集合。状态：✅ 可运行。
var raw = " Python ;\n";
raw = raw + "  python\n";
raw = raw + "\n";
raw = raw + "Go\n";
raw = raw + " go \n";
raw = raw + "rust;\n";
raw = raw + "  \n";
raw = raw + "JavaScript\n";

var lines = str_split_lines(raw);
var seen = dict_new();
var out = arr_new();
var i = 0;
loop (i < arr_len(lines)) {
    var t = str_trim(arr_get(lines, i));
    t = str_replace(t, ";", "");   // str_trim 单参（不能带裁剪集）；分号用替换去
    t = str_lower(t);
    if (str_len(t) > 0 && dict_has(seen, t) == false) {
        dict_set(seen, t, true);
        arr_push(out, t);
    }
    i += 1;
}
arr_sort(out);
i = 0;
loop (i < arr_len(out)) {
    output(arr_get(out, i));
    i += 1;
}
output("distinct tags: " + int_to_str(arr_len(out)));
