// 语料线 · 07 金额格式化（千分位 + 对账合计）
// 任务画像：导出报表的金额列。状态：✅ 可运行。
number_t func group_thousands(int_part) {
    var s = int_to_str(int_part);
    var out = "";
    var c = 0;
    var i = str_len(s) - 1;
    loop (i >= 0) {
        out = char_at(s, i) + out;
        c += 1;
        if (c % 3 == 0 && i > 0) {
            out = "," + out;
        }
        i -= 1;
    }
    return out;
}

number_t func money(v) {
    var neg = v < 0;
    var a = num_abs(v);
    var whole = num_trunc(a);
    var cents = num_round((a - whole) * 100);
    var cents_s = int_to_str(cents);
    if (cents < 10) {
        cents_s = "0" + cents_s;
    }
    var body = group_thousands(whole) + "." + cents_s;
    if (neg) {
        return "-" + body;
    }
    return body;
}

var amounts = arr_new();
arr_push(amounts, 1234567.5);
arr_push(amounts, 9800000.0);
arr_push(amounts, -42.05);
arr_push(amounts, 7.99);
arr_push(amounts, 1000.0);

var total = 0;
var i = 0;
loop (i < arr_len(amounts)) {
    var a = arr_get(amounts, i);
    output(money(a));
    total += a;
    i += 1;
}
output("TOTAL: " + money(total));
