// 语料线 · 03 日志聚合（按级别计数 + 错误模块 top-N）
// 任务画像：运维扫一天的 app.log 出摘要。状态：✅ 可运行。
// 【缺口实证】没有 `continue` —— 短行过滤只能用 if 包裹整个循环体
// （语法面见 testing/corpus/ G-01）。
var log = "";
log = log + " 09:01:00 INFO  [auth] user login ok id=7\n";
log = log + " 09:02:12 WARN  [db] slow query 812ms\n";
log = log + " 09:03:40 ERROR [pay] charge failed code=502\n";
log = log + " 09:03:41 ERROR [pay] retry charge code=502\n";
log = log + " 09:05:00 INFO  [auth] user logout id=7\n";
log = log + " 09:06:03 ERROR [db] pool exhausted\n";
log = log + " 09:07:00 INFO  [api] GET /v1/items 200\n";
log = log + " 09:08:00 WARN  [api] GET /v1/search 404\n";
log = log + " 09:09:00 ERROR [pay] charge failed code=502\n";

var lines = str_split_lines(log);
var lv = dict_new();
var err_mod = dict_new();
var i = 0;
loop (i < arr_len(lines)) {
    var ln = arr_get(lines, i);
    if (str_len(ln) >= 25) {
        var level = str_trim(str_slice(ln, 20, 25));
        if (str_eq_ignore_case(level, "ERROR")) {
            var open = str_find(ln, "[", 0);
            var close = str_find(ln, "]", open);
            if (open >= 0 && close > open) {
                var mod = str_slice(ln, open + 1, close);
                dict_set(err_mod, mod, dict_get_or(err_mod, mod, 0) + 1);
            }
        }
        dict_set(lv, level, dict_get_or(lv, level, 0) + 1);
    }
    i += 1;
}
output("== level summary ==");
var keys = arr_sort(dict_keys(lv));
i = 0;
loop (i < arr_len(keys)) {
    var k = arr_get(keys, i);
    output(str_pad_right(k, 8, " ") + " x" + int_to_str(dict_get(lv, k)));
    i += 1;
}
output("== error modules ==");
keys = arr_sort(dict_keys(err_mod));
i = 0;
loop (i < arr_len(keys)) {
    var m = arr_get(keys, i);
    output(str_pad_right(m, 8, " ") + " x" + int_to_str(dict_get(err_mod, m)));
    i += 1;
}
