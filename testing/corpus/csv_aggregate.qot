// 语料线 · 01 CSV 分组聚合报表（读文件 → 解析 → 分组统计 → 格式化输出）
// 任务画像：小商户月度销售汇总。状态：✅ 可运行（interp + native）。
var csv = "region,item,qty,price\n";
csv = csv + "north,apple,10,3.5\n";
csv = csv + "south,apple,4,3.5\n";
csv = csv + "north,pear,6,2.25\n";
csv = csv + "south,apple,2,3.5\n";
csv = csv + "north,apple,3,3.5\n";
csv = csv + "south,pear,9,2.25\n";

var lines = str_split_lines(csv);
var i = 1;
var n = arr_len(lines);
var totals = dict_new();
var counts = dict_new();
var items = arr_new();
loop (i < n) {
    var row = str_split(arr_get(lines, i), ",");
    var item = arr_get(row, 1);
    var amount = str_to_num(arr_get(row, 2)) * str_to_num(arr_get(row, 3));
    if (dict_has(totals, item) == false) {
        dict_set(totals, item, 0);
        dict_set(counts, item, 0);
        arr_push(items, item);
    }
    dict_set(totals, item, dict_get(totals, item) + amount);
    dict_set(counts, item, dict_get(counts, item) + 1);
    i += 1;
}
arr_sort(items);
output("item   orders total");
i = 0;
loop (i < arr_len(items)) {
    var it = arr_get(items, i);
    output(str_pad_right(it, 7, " ") +
           str_pad_left(int_to_str(dict_get(counts, it)), 6, " ") + " " +
           str_pad_left(num_to_str(dict_get(totals, it), 2), 8, " "));
    i += 1;
}
