// 语料线 · 21 URL 解析（scheme/host/port/path/query 参数抽取）
// 任务画像：网关/爬虫的入参解析。状态：✅ 可运行。
number_t func parse_query(q) {
    var out = dict_new();
    var pairs = str_split(q, "&");
    var i = 0;
    loop (i < arr_len(pairs)) {
        var kv = str_split(arr_get(pairs, i), "=");
        if (arr_len(kv) == 2) {
            dict_set(out, arr_get(kv, 0), url_decode(arr_get(kv, 1)));
        }
        i += 1;
    }
    return out;
}

var url = "https://api.example.com:8443/v1/items?page=2&size=50&tag=hello%20world";
var scheme_end = str_find(url, "://", 0);
var scheme = str_slice(url, 0, scheme_end);
var rest = str_slice(url, scheme_end + 3, str_len(url));
var path_start = str_find(rest, "/", 0);
var hostport = str_slice(rest, 0, path_start);
var pathq = str_slice(rest, path_start, str_len(rest));

var host = hostport;
var port = "443";
var colon = str_find(hostport, ":", 0);
if (colon >= 0) {
    host = str_slice(hostport, 0, colon);
    port = str_slice(hostport, colon + 1, str_len(hostport));
}

var qmark = str_find(pathq, "?", 0);
var path = pathq;
var query = "";
if (qmark >= 0) {
    path = str_slice(pathq, 0, qmark);
    query = str_slice(pathq, qmark + 1, str_len(pathq));
}

output("scheme: " + scheme);
output("host  : " + host);
output("port  : " + port);
output("path  : " + path);
var params = parse_query(query);
var keys = arr_sort(dict_keys(params));
output("params: " + int_to_str(arr_len(keys)));
var i = 0;
loop (i < arr_len(keys)) {
    var k = arr_get(keys, i);
    output("  " + k + " = " + dict_get(params, k));
    i += 1;
}
