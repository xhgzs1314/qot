// 语料线 · 13 批量改名计划（path_* 拆解 + 规则变换 + dry-run 清单）
// 任务画像：把 IMG_xxx.jpg 改成 2026_img_xxx.jpg 前的计划预览。状态：✅ 可运行。
var files = arr_new();
arr_push(files, "vacation/IMG_001.jpg");
arr_push(files, "vacation/IMG_002.jpg");
arr_push(files, "vacation/IMG_003.jpg");
arr_push(files, "notes/draft.txt");
arr_push(files, "vacation/IMG_004.png");

var plan = arr_new();
var i = 0;
loop (i < arr_len(files)) {
    var p = arr_get(files, i);
    var ext = path_ext(p);
    if (ext == ".jpg" || ext == ".png") {
        var stem = path_stem(p);
        var dir = path_dirname(p);
        var new_name = "2026_" + str_lower(stem) + ext;
        arr_push(plan, p + "  ->  " + path_join(dir, new_name));
    } else {
        arr_push(plan, "skip (not media): " + p);
    }
    i += 1;
}
i = 0;
loop (i < arr_len(plan)) {
    output(arr_get(plan, i));
    i += 1;
}
