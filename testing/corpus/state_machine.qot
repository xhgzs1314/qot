// 语料线 · 18 订单状态机（合法迁移表 + 事件序列回放）
// 任务画像：业务流校验。状态：✅ 可运行。
var transitions = &<
    "created": &< "pay": "paid", "cancel": "cancelled" >&,
    "paid": &< "ship": "shipped", "refund": "refunded" >&,
    "shipped": &< "deliver": "delivered" >&,
    "delivered": &< >&,
    "cancelled": &< >&,
    "refunded": &< >&
>&;

var events = arr_new();
arr_push(events, "pay");
arr_push(events, "ship");
arr_push(events, "deliver");

var state = "created";
var log = arr_new();
arr_push(log, "start: " + state);
var i = 0;
var ok = true;
loop (i < arr_len(events)) {
    var ev = arr_get(events, i);
    var table = dict_get(transitions, state);
    if (dict_has(table, ev)) {
        state = dict_get(table, ev);
        arr_push(log, ev + " -> " + state);
    } else {
        arr_push(log, "ILLEGAL " + ev + " in " + state);
        ok = false;
    }
    i += 1;
}
i = 0;
loop (i < arr_len(log)) {
    output(arr_get(log, i));
    i += 1;
}
output("final: " + state + " (ok=" + strings(ok) + ")");
