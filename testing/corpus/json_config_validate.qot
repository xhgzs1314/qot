// 语料线 · 02 JSON 配置校验（解码 → 字段存在性/类型/范围检查 → 诊断清单）
// 任务画像：服务启动前检查 config.json。状态：✅ 可运行。
var cfg_text = "{\"port\": 8080, \"host\": \"0.0.0.0\", \"workers\": 4, \"debug\": true, \"timeout_ms\": 3000}";
if (json_valid(cfg_text) == false) {
    output("FATAL: config is not valid JSON");
    prog_end(1);
}
var cfg = json_decode(cfg_text);
var problems = arr_new();

if (dict_has(cfg, "port") == false) {
    arr_push(problems, "missing field: port");
} else {
    if (is_string(dict_get(cfg, "port"))) {
        arr_push(problems, "port must be number");
    } else {
        var port = dict_get(cfg, "port");
        if (port < 1 || port > 65535) {
            arr_push(problems, "port out of range [1,65535]");
        }
    }
}
if (dict_has(cfg, "host") == false) {
    arr_push(problems, "missing field: host");
}
if (dict_has(cfg, "workers") == false) {
    arr_push(problems, "missing field: workers");
} else {
    if (dict_get(cfg, "workers") < 1) {
        arr_push(problems, "workers must be >= 1");
    }
}
if (dict_has(cfg, "timeout_ms") == false) {
    arr_push(problems, "missing field: timeout_ms (defaults would hide typos)");
}

if (arr_len(problems) == 0) {
    output("config OK: port=" + int_to_str(dict_get(cfg, "port")) +
           " workers=" + int_to_str(dict_get(cfg, "workers")));
} else {
    output("config has " + int_to_str(arr_len(problems)) + " problem(s):");
    var i = 0;
    loop (i < arr_len(problems)) {
        output("  - " + arr_get(problems, i));
        i += 1;
    }
}
