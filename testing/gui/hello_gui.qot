// ===========================================================================
// hello_gui.qot —— GUI 可用性验证小工具
//
// 给 Python 初学者的对照表（左 = tkinter, 右 = QOT）：
//   tk.Tk()                    对应  vg_create_window(标题, 宽, 高)
//   root.title("...")          对应  vg_set_window_title(w, "...")
//   tk.Label(root, text=...)   对应  vg_create_label(w, 文本, x, y, 宽, 高)
//   tk.Entry(root)             对应  vg_create_textbox(w, 占位文本, x, y, 宽, 高)
//   entry.get()                对应  vg_textbox_get_text(id)
//   tk.Button(command=回调)     对应  vg_create_button(w, 文本, x, y, 宽, 高)
//   label.config(text="...")   对应  vg_label_set_text(id, "...")
//   root.mainloop()            对应  loop { vg_wait_event(15) ... }
//   root.destroy()             对应  vg_close_window(w)
//
// 与 tkinter 的唯一差别：tkinter 的 command= 是"按钮被点时帮你调函数"，
// QOT 把同一件事写成主循环里的显式分派：事件 [控件id, kind, value]，
// kind 1 = 点击。两个引擎（解释器 / 原生 exe）行为逐位一致。
// ===========================================================================

var w = vg_create_window("你好 · GUI", 520, 340);
vg_set_window_bg_gradient(w, [0.06, 0.06, 0.13, 1], [0.11, 0.09, 0.2, 1]);

var title = vg_create_label(w, "QOT GUI · 第一课：打招呼", 40, 26, 440, 30);
vg_label_set_font_size(title, 19);

var hint = vg_create_label(w, "在输入框里写上名字，再点[打招呼]", 40, 70, 440, 24);
vg_label_set_text_color(hint, [0.62, 0.66, 0.78, 1]);

var name_box = vg_create_textbox(w, "在这里输入名字...", 40, 104, 300, 34);

var btn_hello = vg_create_button(w, "打招呼", 40, 152, 140, 42);
vg_button_set_border_radius(btn_hello, 8);

var btn_clear = vg_create_button(w, "清空", 196, 152, 100, 42);
vg_button_set_border_radius(btn_clear, 8);

var result = vg_create_label(w, "结果会显示在这里", 40, 216, 440, 28);
vg_label_set_font_size(result, 16);
vg_label_set_text_color(result, [0.55, 0.85, 1, 1]);

var events = 0;
var greets = 0;
var running = 1;

vg_show_window(w);

loop (running == 1) {
    var ev = vg_wait_event(15);          // ← mainloop 的心跳
    if (ev == null) {
        continue;                        // 超时无事件（内部已泵完消息）
    }
    events = events + 1;
    var id = ev[0];
    var kind = ev[1];

    if (kind == 9) {                     // 窗口被 X 掉
        running = 0;
    } else {
        if (kind == 1 && id == btn_hello) {   // ← 「打招呼」按钮的回调
            var name = vg_textbox_get_text(name_box);   // ← entry.get()
            if (name == null || name == "") {
                vg_label_set_text(result, "请先输入名字");
            } else {
                greets = greets + 1;
                vg_label_set_text(result, "你好, " + name + "！");
            }
        }
        if (kind == 1 && id == btn_clear) {
            vg_textbox_set_text(name_box, "");
            vg_label_set_text(result, "结果会显示在这里");
        }
    }
}

// 关窗后的控制台报告：同时验证 output 与 GUI 共存
output("hello-gui-ok events=" + events + " greets=" + greets);

