// 自动关闭版（无人值守验证主循环/事件/退出链路）：约 1.5 秒后自行关闭。
var w = vg_create_window("自动关闭验证", 420, 260);
var lb = vg_create_label(w, "1.5 秒后自动关闭", 30, 30, 320, 26);
vg_show_window(w);
var n = 0;
var quit = 0;
loop (quit == 0 && n < 100) {
    var ev = vg_wait_event(15);
    n = n + 1;
    if (ev != null) {
        if (ev[1] == 9) {
            quit = 1;
        }
    }
}
vg_close_window(w);
output("auto-ok " + n);
