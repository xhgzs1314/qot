// ============================================================================
// fw_lib —— 模块内前向互调钉的载荷模块（P1030-2 · ）
// ----------------------------------------------------------------------------
// entry 声明在 double_it 之前却调用它（前向调用）。
//   * interp：模块装载两遍 sema（module_unit）+ wrapper 全量安装
//     module_funcs → 序无关；
//   * native：require_inliner 合并后顶层函数稳定前置 → 合并单元同样序无关。
// 修复前：interp [3001] 函数未定义 + 每处 mod##fn 两条 sema 警告；
//         native 合并单元 sema 报「函数未定义」警告（stderr 污染）。
// ============================================================================

number_t func entry(x) {
    return double_it(x);
}

number_t func double_it(x) {
    return x + x;
}
