// B6a 大数组 · push 扩容到 ITER（摊还代价）
// 负载：从空数组起，ITER 次 push，最后输出长度。
// 拷问点：QArr 的扩容策略（增长因子）与摊还代价；1e7 级元素时
// 扩容期的整块 memcpy 是否形成可观测的时间毛刺（两点差分会把
// 摊还后的均值给出来，毛刺由 b6a 的 delta_iqr 观察）。
// 内存：1e7 * 16B(V16) = 160MB，加上扩容期的旧块，峰值可能到 480MB。
var a = [];
var i = 0;
loop (i < 87654321) {
    push(a, i);
    i = i + 1;
}
output(glen(a));
