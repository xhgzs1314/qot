// B6b 大数组 · 顺序读（缓存效应；per_unit = 每次下标读 + 累加）
// 负载：先建 1e6 元素定长数组（16MB，超出 L2/L3 常见容量，制造真实的
// 缓存未命中），再做 ITER 次 a[i % 1000000] 顺序读并累加。
// 为什么用 1e6 而不是 1e7 做常驻数组：两点差分要求「构造段与 ITER 无关」，
// 而构造 1e7 元素本身要 160MB 且耗时不可忽略；1e6 已足以让工作集
// 超出末级缓存，同时把构造开销压到可忽略。
// 拷问点：V16 是 16 字节值类型，顺序读的带宽上限 = 16B/元素；
// 若 per_unit 换算出的带宽远低于硬件带宽，说明下标路径有额外开销。
var a = [];
var k = 0;
loop (k < 1000000) {
    push(a, k);
    k = k + 1;
}
var t = 0;
for (i in 87654321) {
    t = t + a[i % 1000000];
}
output(t);
