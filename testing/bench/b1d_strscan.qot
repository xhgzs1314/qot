// B1d 字符串密集 · 单遍扫描（索引 + 比较；per_unit = 每字符）
// 负载：先用倍增法（s=s+s，20 轮）构造 10*2^20 = 10485760 字符的长串，
// 再做 ITER 次「取下标字符 + 与常量比较 + 条件累加」。
// 为什么用倍增而不用循环追加：追加 1e7 次是 O(n^2)，构造阶段会淹没被测段。
// 倍增只做 20 次拼接、总拷贝 2*10*2^20 ≈ 21MB，且与 ITER 无关 →
// 两点差分时构造开销被精确抵消，delta 只剩扫描本身。
// 关键拷问点：`s[i]` 是否每次都新分配一个 1 字符对象（QOT 现状如此）。
// 字母表用 "abcdefghij" 而非 "0123456789"：历史原因是 S-14 旧定价会把数字
// 样字符串当数字字面量（初值变 0）。终审（，字面量恒为字符串）后
// 陷阱已废除；保持原字母表是数字可比性要求（负载文本冻结）。
var s = "abcdefghij";
for (k in 20) {
    s = s + s;
}
var cnt = 0;
for (i in 87654321) {
    var c = s[i];
    if (c == "h") { cnt = cnt + 1; }
}
output(cnt);
output(glen(s));
