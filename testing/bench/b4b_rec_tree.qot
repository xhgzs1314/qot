// B4b 深层递归 · 树递归（二叉，分支因子 2）
// 负载：tsum(d) = tsum(d-1) + tsum(d-1)，叶子返回 1。
// units(n) = 2^(n+1) - 1（总调用次数）。这里 ITER 是**深度**不是调用数，
// 所以 n 与 n/2 的差分量是 2^n 级别的 —— 台架用 units() 精确换算，
// 不能简单按 (n - n/2) 除。
// 拷问点：① 每层栈帧成本（与 b4a 对照）② 调用密集下 N-04 双体调用是否
// 仍然有效 ③ 深度安全上限（同 b4a）。
number_t func tsum(d) {
    if (d <= 0) { return 1; }
    return tsum(d - 1) + tsum(d - 1);
}
output(tsum(87654321));
