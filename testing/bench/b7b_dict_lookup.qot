// B7b 大字典 · 1e6 键命中查找（含键构造；per_unit = 每次查找）
// 负载：先建 1e6 键的字典（键为数字转字符串，模拟真实业务的字符串键），
// 再做 ITER 次 m[strings(i % 1000000)] 命中查找。
// 与 B2a 的分工：B2a 是 5 键热表（整表在 L1 里，探测序列几乎零未命中）；
// 这里是 1e6 键冷表（QDict 的槽数组远超缓存），per_unit 里包含真实的
// 内存未命中代价。两者相减 ≈ 缓存效应，相加 ≈ 真实业务字典的下界。
// 另：键每次都重新构造（strings() 新分配），故本负载同时拷问
// 「动态键构造 + 大表探测」的组合成本。
var m = &< "z": 0 >&;
var k = 0;
loop (k < 1000000) {
    m[strings(k)] = k;
    k = k + 1;
}
var t = 0;
for (i in 87654321) {
    var key = strings(i % 1000000);
    t = t + m[key];
}
output(t);
