// ============================================================================
// std.net —— HTTP 客户端标准库
// ============================================================================

// 解析 "scheme://host[:port]/path" → dict{scheme,host,port,path}。
// 非 URL（无 "://"）→ null；无路径 → "/"；无端口 → 80；端口越界 → null。
// （S-14 注意：端口是运行期字符串值，str_to_num 正常解析——只有字面量
// 才有数字样定价，运行期拼接的 "8080" 是真字符串。）
any_t func url_parse(url) {
    var pos = str_find(url, "://", 0);
    if (pos < 0) {
        return null;
    }
    var scheme = str_slice(url, 0, pos);
    var rest = pos + 3;
    var n = str_len(url);
    var slash = str_find(url, "/", rest);
    var hostport = "";
    var path = "/";
    if (slash >= 0) {
        hostport = str_slice(url, rest, slash);
        path = str_slice(url, slash, n);
    } else {
        hostport = str_slice(url, rest, n);
    }
    var host = hostport;
    var port = 80;
    var colon = str_find(hostport, ":", 0);
    if (colon >= 0) {
        host = str_slice(hostport, 0, colon);
        port = str_to_num(str_slice(hostport, colon + 1, str_len(hostport)));
        if (port <= 0 || port > 65535) {
            return null;
        }
    }
    var d = dict_new();
    dict_set(d, "scheme", scheme);
    dict_set(d, "host", host);
    dict_set(d, "port", port);
    dict_set(d, "path", path);
    return d;
}

// 私有：发一次 HTTP/1.0 请求并收完整响应（状态行 + 头 + EOF 分帧的体）。
// 任一步失败 → null（socket 资源总是被关闭）。
any_t func _net_request(url, method, body, ctype) {
    var u = url_parse(url);
    if (u == null) {
        return null;
    }
    var h = socket_new();
    if (h == null) {
        return null;
    }
    var connected = socket_connect(h, dict_get(u, "host"), dict_get(u, "port"));
    if (connected == false) {
        socket_close(h);
        return null;
    }
    socket_set_timeout(h, 10000);
    var req = method + " " + dict_get(u, "path") + " HTTP/1.0\r\nHost: "
        + dict_get(u, "host");
    if (str_empty(ctype) == false) {
        req = req + "\r\nContent-Type: " + ctype;
    }
    req = req + "\r\nConnection: close\r\n\r\n" + body;
    if (socket_send_all(h, req) < 0) {
        socket_close(h);
        return null;
    }
    // 状态行："HTTP/1.x 200 OK" → 第 2 个 token = 状态码
    var line = socket_recv_line(h);
    if (str_empty(line)) {
        socket_close(h);
        return null;
    }
    var parts = str_split(line, " ");
    var status = 0;
    if (arr_len(parts) >= 2) {
        status = str_to_num(arr_get(parts, 1));
    }
    // 头部循环：读到空行（recv_line 剥完 \r\n 后返回 ""）
    var scanning = true;
    loop (scanning) {
        var hl = socket_recv_line(h);
        if (str_empty(hl)) {
            scanning = false;
        }
    }
    // 体：读到 EOF（Connection: close 分帧）
    var rbody = "";
    var reading = true;
    loop (reading) {
        var chunk = socket_recv(h, 65536);
        if (str_empty(chunk)) {
            reading = false;
        } else {
            rbody = rbody + chunk;
        }
    }
    socket_close(h);
    var out = dict_new();
    dict_set(out, "status", status);
    dict_set(out, "body", rbody);
    return out;
}

// GET url → dict{status, body}；失败 null（URL 非法/连接失败/协议错）。
any_t func http_get(url) {
    return _net_request(url, "GET", "", "");
}

// POST url, body [, ctype] → dict{status, body}；失败 null。
any_t func http_post(url, body, ctype) {
    return _net_request(url, "POST", body, ctype);
}

// 下载 url 响应体到文件（文本覆写）→ true/false。
// 文件失败回传 false；HTTP 层失败（null）同样 false —— 需要区分时用 http_get。
boolean_t func download(url, path) {
    var r = http_get(url);
    if (r == null) {
        return false;
    }
    return file_write(path, dict_get(r, "body")) > 0;
}

// ============================================================================
// HTTP 服务端（select 多路复用，单进程多连接并发）
// ============================================================================
any_t func http_server(host, port, handler, duration_ms) {
    var srv = socket_new();
    if (srv == null) {
        return null;
    }
    if (socket_bind(srv, host, port) == false) {
        socket_close(srv);
        return null;
    }
    if (socket_listen(srv, 64) == false) {
        socket_close(srv);
        return null;
    }
    // 活句柄数组（[0] = listen 恒在）+ 每连接已收文本（[0] 占位）。
    var hs = arr_new();
    push(hs, srv);
    var bufs = arr_new();
    push(bufs, "");
    var served = 0;
    var bytes_out = 0;
    var peak_conns = 0;
    var accept_reject = 0;
    var deadline = time_now_ms() + duration_ms;
    var running = true;
    loop (running) {
        var left = deadline - time_now_ms();
        if (left <= 0) {
            running = false;
        } else {
            // 等待窗口：上限 500ms（tick 检查点；select 被信号打断也不失 deadlines）
            if (left > 500) {
                left = 500;
            }
            var ready = socket_select(hs, left);
            var rc = arr_len(ready);
            var k = 0;
            loop (k < rc) {
                var h = arr_get(ready, k);
                if (h == srv) {
                    // accept 面（上限 62：hs 里 listen+61 连接；满载时
                    // 暂不 accept，内核 backlog 排队，下个就绪周期再收）
                    if (arr_len(hs) < 62) {
                        var c = socket_accept(srv);
                        if (c == null) {
                            accept_reject = accept_reject + 1;
                        } else {
                            push(hs, c);
                            push(bufs, "");
                            var nc = arr_len(hs) - 1;
                            if (nc > peak_conns) {
                                peak_conns = nc;
                            }
                        }
                    }
                } else {
                    // 连接面：收请求
                    var idx = arr_index_of(hs, h);
                    if (idx < 1) {
                        // 并行数组不同步（理论不可达）：关句柄防御
                        socket_close(h);
                    } else {
                        var chunk = socket_recv(h, 4096);
                        if (str_empty(chunk)) {
                            // EOF / 错误 / 超时（连接无 timeout → 阻塞 recv 不空
                            // 不返 —— select 就绪下的 "" 即对端关闭或错误）
                            socket_close(h);
                            arr_remove_at(hs, idx);
                            arr_remove_at(bufs, idx);
                        } else {
                            var b = arr_get(bufs, idx) + chunk;
                            arr_set(bufs, idx, b);
                            if (str_len(b) > 65536) {
                                // 请求头超限：直接关闭
                                socket_close(h);
                                arr_remove_at(hs, idx);
                                arr_remove_at(bufs, idx);
                            } else {
                                if (str_find(b, "\r\n\r\n", 0) >= 0) {
                                    // 请求头齐了：解析请求行取 path
                                    var line_end = str_find(b, "\r\n", 0);
                                    var req_line = str_slice(b, 0, line_end);
                                    var parts = str_split(req_line, " ");
                                    var path = "/";
                                    if (arr_len(parts) >= 2) {
                                        path = arr_get(parts, 1);
                                    }
                                    // 应答
                                    var body = handler(path);
                                    var head = "";
                                    if (body == null) {
                                        head = "HTTP/1.0 404 Not Found\r\n"
                                            + "Content-Type: text/plain\r\n"
                                            + "Content-Length: 0\r\n"
                                            + "Connection: close\r\n\r\n";
                                        body = "";
                                    } else {
                                        head = "HTTP/1.0 200 OK\r\n"
                                            + "Content-Type: text/plain\r\n"
                                            + "Content-Length: "
                                            + num_to_str_int(str_len(body))
                                            + "\r\n"
                                            + "Connection: close\r\n\r\n";
                                    }
                                    socket_send_all(h, head + body);
                                    served = served + 1;
                                    bytes_out = bytes_out + str_len(body);
                                    socket_close(h);
                                    arr_remove_at(hs, idx);
                                    arr_remove_at(bufs, idx);
                                }
                            }
                        }
                    }
                }
                k = k + 1;
            }
        }
    }
    // 收尾：关全部活句柄
    var j = arr_len(hs);
    loop (j > 0) {
        socket_close(arr_get(hs, j - 1));
        j = j - 1;
    }
    var out = dict_new();
    dict_set(out, "served", served);
    dict_set(out, "bytes_out", bytes_out);
    dict_set(out, "peak_conns", peak_conns);
    dict_set(out, "accept_reject", accept_reject);
    return out;
}
