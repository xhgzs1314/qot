// ============================================================================
// std.fs —— 文件系统便利层
// ============================================================================

// ---- 按行读文本文件（\r\n/\n 归一为无行尾；文件末换行=终止符非空行）----
// 失败（打不开/路径是目录）→ null。
array_t func read_lines(path) {
    var h = file_open(path, "r");
    if (is_null(h)) { return null; }
    var text = file_read_all(h);
    file_close(h);
    var lines = str_split_lines(text);
    var ln = arr_len(lines);
    if (ln > 0) {
        if (str_empty(arr_get(lines, ln - 1))) { arr_pop(lines); }
    }
    return lines;
}

// ---- 按行写文本文件（每行补 \n；覆盖语义；lines 非数组 → false）----
boolean_t func write_lines(path, lines) {
    if (type_is(lines, "array") == false) { return false; }
    var h = file_open(path, "w");
    if (is_null(h)) { return false; }
    var i = 0;
    var n = arr_len(lines);
    loop (i < n) {
        file_write(h, strings(arr_get(lines, i)));
        file_write(h, "\n");
        i += 1;
    }
    return file_close(h);
}

// ---- 按行追加文本文件（每行补 \n；失败 → false）----
boolean_t func append_lines(path, lines) {
    if (type_is(lines, "array") == false) { return false; }
    var h = file_open(path, "a");
    if (is_null(h)) { return false; }
    var i = 0;
    var n = arr_len(lines);
    loop (i < n) {
        file_write(h, strings(arr_get(lines, i)));
        file_write(h, "\n");
        i += 1;
    }
    return file_close(h);
}

// 私有：递归体（out 就地追加；prefix = "" 或 "sub/dir"）
// 顺序纪律：QOT sema 要求先声明后用 —— 私有实现一律前置。
any_t func _sfs_walk(dir, prefix, out) {
    var names = dir_list(dir);
    if (is_null(names)) { return null; }
    var i = 0;
    var n = arr_len(names);
    loop (i < n) {
        var name = arr_get(names, i);
        var rel = name;
        if (str_len(prefix) > 0) { rel = prefix + "/" + name; }
        var full = path_join(dir, name);
        if (path_is_dir(full)) {
            arr_push(out, rel + "/");
            _sfs_walk(full, rel, out);
        } else {
            arr_push(out, rel);
        }
        i += 1;
    }
    return null;
}

// 私有：通配匹配（* = 任意串含空；? = 恰一字符；其余按字节精确）
boolean_t func _sfs_match(s, si, p, pi) {
    var sl = str_len(s);
    var pl = str_len(p);
    loop (pi < pl) {
        var pc = str_byte_at(p, pi);
        if (pc == 42) { // '*'
            if (pi + 1 >= pl) { return true; }
            var rest_p = str_slice(p, pi + 1, pl);
            var j = si;
            loop (j <= sl) {
                if (_sfs_match(str_slice(s, j, sl), 0, rest_p, 0)) { return true; }
                j += 1;
            }
            return false;
        }
        if (si >= sl) { return false; }
        var sc = str_byte_at(s, si);
        if (pc == 63) { // '?'
            si += 1;
            pi += 1;
        } else {
            if (sc != pc) { return false; }
            si += 1;
            pi += 1;
        }
    }
    return si == sl;
}

// ---- 递归遍历目录（返回相对 dir 的路径；目录带 / 尾；非目录 → null）----
// 顺序 = dir_list 的字典序（原语保证），递归先序。
array_t func walk(dir) {
    if (path_is_dir(dir) == false) { return null; }
    var out = arr_new();
    _sfs_walk(dir, "", out);
    return out;
}

// ---- 目录内通配匹配（* 任意串 / ? 单字符；只匹配文件与目录名，不递归）----
// pattern 空或 names 取不到 → null。
array_t func glob(dir, pattern) {
    var names = dir_list(dir);
    if (is_null(names)) { return null; }
    var out = arr_new();
    var i = 0;
    var n = arr_len(names);
    loop (i < n) {
        var name = arr_get(names, i);
        if (_sfs_match(name, 0, pattern, 0)) { arr_push(out, name); }
        i += 1;
    }
    return out;
}
