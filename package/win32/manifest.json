{
    "author": "MOK-XI",
    "gp": "https://github.com/MOK-XI/qot-plugins",
    "ct": "mokxi@example.com",
    "m": {
        "n": "win32",
        "d": "Windows API 调用模块，提供对 user32、kernel32、gdi32 等系统 DLL 的访问",
        "f": [
            {
                "n": "get_address",
                "d": "获取 Windows API 函数地址",
                "p": "str",
                "r": "ptr",
                "de": [
                    "函数名称（如 MessageBoxW、CreateWindowExW）"
                ]
            },
            {
                "n": "get_const",
                "d": "获取 Windows 常量值（窗口样式、消息框类型、虚拟键码等）",
                "p": "str",
                "r": "dword",
                "de": [
                    "常量名称（如 WS_VISIBLE、MB_OK、VK_RETURN）"
                ]
            },
            {
                "n": "call_address",
                "d": "调用函数地址（指定参数个数）",
                "p": "ptr,int",
                "r": "dword",
                "de": [
                    "函数地址",
                    "参数个数",
                    "参数列表..."
                ]
            },
            {
                "n": "call_func",
                "d": "调用函数地址（自动检测参数，参数以 0xFFFFFFFFFFFFFFFF 结尾）",
                "p": "ptr",
                "r": "dword",
                "de": [
                    "函数地址",
                    "参数列表...（以 -1 结尾）"
                ]
            },
            {
                "n": "get_last_error",
                "d": "获取最后一个错误码",
                "p": "",
                "r": "dword",
                "de": []
            },
            {
                "n": "set_last_error",
                "d": "设置最后一个错误码",
                "p": "dword",
                "r": "void",
                "de": [
                    "错误码"
                ]
            }
        ]
    }
}