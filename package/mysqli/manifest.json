{
    "author": "MOK-XI",
    "gp": "https://github.com/MOK-XI/qot-plugins",
    "ct": "mokxi@example.com",
    "m": {
        "n": "mysqli",
        "d": "提供MySQL数据库操作相关功能",
        "f": [
            {
                "n": "MySQLConnect",
                "d": "建立与MySQL数据库的连接",
                "p": "string_t",
                "r": "number_t",
                "de": [
                    "连接数据库的参数字符串，格式通常为\"host=主机名;user=用户名;password=密码;dbname=数据库名\""
                ]
            },
            {
                "n": "MySQLClose",
                "d": "关闭MySQL数据库连接",
                "p": "number_t",
                "r": "number_t",
                "de": [
                    "需要关闭的数据库连接标识（由MySQLConnect返回）"
                ]
            },
            {
                "n": "MySQLExecute",
                "d": "执行MySQL语句",
                "p": "number_t, string_t",
                "r": "long",
                "de": [
                    "数据库连接标识",
                    "要执行的MySQL语句字符串（如INSERT、UPDATE、DELETE等）"
                ]
            },
            {
                "n": "MySQLQuery",
                "d": "执行MySQL查询并返回结果",
                "p": "number_t, string_t",
                "r": "string_t",
                "de": [
                    "数据库连接标识",
                    "要执行的MySQL查询语句字符串（如SELECT等）"
                ]
            },
            {
                "n": "MySQLPrepare",
                "d": "准备MySQL预处理语句",
                "p": "number_t, string_t, string_t",
                "r": "long",
                "de": [
                    "数据库连接标识",
                    "预处理语句模板字符串",
                    "参数类型字符串，用于指定预处理语句中参数的类型"
                ]
            },
            {
                "n": "MySQLFreeString",
                "d": "释放MySQL操作返回的字符串资源",
                "p": "string_t",
                "r": "void",
                "de": [
                    "需要释放的由MySQL操作返回的字符串资源"
                ]
            }
        ]
    }
}