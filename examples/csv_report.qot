// ============================================================================
// csv_report —— 「CSV → 统计 → 报表」真实任务
// ----------------------------------------------------------------------------
// 运行：python index.py aot examples/csv_report.qot demo.exe && demo.exe
// ============================================================================
require "../std/text.qot";
require "../std/fs.qot";

// ---- 样例数据 → CSV 落盘 ----
var rows = arr_new();
var r = arr_new();
arr_push(r, "category");
arr_push(r, "region");
arr_push(r, "amount");
arr_push(rows, r);
r = arr_new();
arr_push(r, "fruit"); arr_push(r, "north"); arr_push(r, "120.5"); arr_push(rows, r);
r = arr_new();
arr_push(r, "veg"); arr_push(r, "south"); arr_push(r, "77.75"); arr_push(rows, r);
r = arr_new();
arr_push(r, "fruit"); arr_push(r, "north"); arr_push(r, "43.25"); arr_push(rows, r);
r = arr_new();
arr_push(r, "dairy"); arr_push(r, "north"); arr_push(r, "99.9"); arr_push(rows, r);
r = arr_new();
arr_push(r, "veg"); arr_push(r, "north"); arr_push(r, "61"); arr_push(rows, r);
r = arr_new();
arr_push(r, "dairy"); arr_push(r, "south"); arr_push(r, "64.1"); arr_push(rows, r);
r = arr_new();
arr_push(r, "fruit"); arr_push(r, "south"); arr_push(r, "80"); arr_push(rows, r);
r = arr_new();
arr_push(r, "dairy"); arr_push(r, "north"); arr_push(r, "58"); arr_push(rows, r);

var demo_dir = "testing/.artifacts/csv_report_demo";
dir_mkdirs(demo_dir);
var csv_text = text##csv_write(rows);
var fh = file_open(demo_dir + "/sales.csv", "w");
file_write(fh, csv_text);
file_close(fh);

// ----  读回 + 解析 ----
var back = fs##read_lines(demo_dir + "/sales.csv");
var text2 = str_join(back, "\n");
var parsed = text##csv_parse(text2);
var header = arr_get(parsed, 0);
var data = arr_slice(parsed, 1, arr_len(parsed));

// ---- 按类目聚合 ----
var count = dict_new();
var total = dict_new();
var mn = dict_new();
var mx = dict_new();
var cats = arr_new();
var i = 0;
var nd = arr_len(data);
loop (i < nd) {
    var row = arr_get(data, i);
    var cat = str_trim(strings(arr_get(row, 0)));
    var amt = str_to_num(arr_get(row, 2));
    if (dict_has(count, cat) == false) {
        dict_set(count, cat, 0);
        dict_set(total, cat, 0);
        dict_set(mn, cat, amt);
        dict_set(mx, cat, amt);
        arr_push(cats, cat);
    }
    dict_set(count, cat, dict_get(count, cat) + 1);
    dict_set(total, cat, dict_get(total, cat) + amt);
    if (amt < dict_get(mn, cat)) { dict_set(mn, cat, amt); }
    if (amt > dict_get(mx, cat)) { dict_set(mx, cat, amt); }
    i += 1;
}
arr_sort(cats);

// ----  报表（stdout + 文件）----
var report = arr_new();
arr_push(report, "== 销售报表（CSV -> 统计 -> 报表）==");
arr_push(report, str_format("header : %s", str_join(header, ",")));
arr_push(report, str_format("rows   : %d", arr_len(data)));
arr_push(report, "category count total    mean     min      max");

i = 0;
var nc = arr_len(cats);
loop (i < nc) {
    var cat = arr_get(cats, i);
    var c = dict_get(count, cat);
    var t = dict_get(total, cat);
    var mean = num_round(t / c, 2);
    var line = str_pad_right(cat, 8, " ") +
               str_pad_left(int_to_str(c), 5, " ") + " " +
               str_pad_left(num_to_str(t, 2), 8, " ") + " " +
               str_pad_left(num_to_str(mean, 2), 8, " ") + " " +
               str_pad_left(num_to_str(dict_get(mn, cat), 2), 8, " ") + " " +
               str_pad_left(num_to_str(dict_get(mx, cat), 2), 8, " ");
    arr_push(report, line);
    i += 1;
}

var report_path = demo_dir + "/report.txt";
var wrote = fs##write_lines(report_path, report);

i = 0;
loop (i < arr_len(report)) {
    output(arr_get(report, i));
    i += 1;
}
output(str_format("report written: %s / %d lines", strings(wrote), arr_len(report)));
