// ============================================================================
// logstat —— Web 访问日志分析器
// ----------------------------------------------------------------------------
//
// 日志行格式（common log format 简化形，空格分词）：
//   IP - - [day/month/year:hh:mm:ss +0800] "METHOD /path HTTP/1.1" status bytes
// ============================================================================

require "../../std/fs.qot";
require "../../std/data.qot";
require "../../std/cli.qot";

// ---- 私有：两位数补零（"07"）----
string_t func _ls_pad2(n) {
    return str_pad_left(int_to_str(n), 2, "0");
}

// ---- 私有：合成一行 common 格式日志----
string_t func _ls_line(i) {
    var ip = "10.0." + int_to_str(int_div(int_mod(i, 50), 10)) + "." +
             int_to_str(int_mod(i, 10));
    var hh = _ls_pad2(8 + int_div(i, 120));
    var mm = _ls_pad2(int_div(int_mod(i, 120), 2));
    var path = "";
    var method = "GET";
    var m = int_mod(i, 10);
    if (m < 6) {
        path = "/index.html";
    } else {
        if (m < 8) {
            path = "/api/items";
        } else {
            if (m < 9) {
                path = "/static/app.js";
                method = "POST";
            } else {
                path = "/wp-admin.php";
            }
        }
    }
    var status = 200;
    var s = int_mod(i, 20);
    if (s < 12) {
        status = 200;
    } else {
        if (s < 14) {
            status = 304;
        } else {
            if (s < 16) {
                status = 404;
                path = "/missing.gif";
            } else {
                if (s < 18) {
                    status = 200;
                } else {
                    status = 500;
                    path = "/api/items";
                }
            }
        }
    }
    var bytes = 200 + int_mod(i * 37, 4000);
    var head = ip + " - - [01/Nov/2026:" + hh + ":" + mm + ":00 +0800] \"";
    return head + method + " " + path + " HTTP/1.1\" " + int_to_str(status) +
           " " + int_to_str(bytes);
}

// ---- 私有：解析一行 → [ip, path, status, bytes]；不合式 → null ----
// 分词索引（common 格式空格分词，时间字段内的空格占两槽）：
//   tok0=ip tok3=[date tok4=+0800] tok5="METHOD tok6=/path tok7=HTTP/1.1"
//   tok8=status tok9=bytes
any_t func _ls_parse(line) {
    var tok = str_split(line, " ");
    if (arr_len(tok) < 10) { return null; }
    var ip = arr_get(tok, 0);
    var path = arr_get(tok, 6);
    var status = str_to_int(arr_get(tok, 8));
    var nbytes = str_to_int(arr_get(tok, 9));
    if (status < 0 || nbytes < 0) { return null; }
    var row = arr_new();
    arr_push(row, ip);
    arr_push(row, path);
    arr_push(row, int_to_str(status));
    arr_push(row, int_to_str(nbytes));
    return row;
}

// ---- ① 命令行：--lines N（默认 500）、--out 报告路径（默认 logstat_report.txt）----
var argv = args_get();
var flags = dict_get(cli##parse_flags(argv), "flags");
var total = 500;
if (is_null(dict_get(flags, "lines")) == false) {
    var want = str_to_int(dict_get(flags, "lines"));
    if (want > 0) { total = want; }
}
var out_path = "logstat_report.txt";
if (is_null(dict_get(flags, "out")) == false) {
    out_path = strings(dict_get(flags, "out"));
}

// ---- ② 生成日志 + 逐行解析 ----
var raw = arr_new();
var i = 0;
loop (i < total) {
    arr_push(raw, _ls_line(i));
    i += 1;
}
var log_path = "access.log";
fs##write_lines(log_path, raw);

var parsed = arr_new();
var bad = 0;
var back = fs##read_lines(log_path);
i = 0;
var n = arr_len(back);
loop (i < n) {
    var row = _ls_parse(arr_get(back, i));
    if (is_null(row)) {
        bad += 1;
    } else {
        arr_push(parsed, row);
    }
    i += 1;
}

// ---- ③ 聚合：PV / UV / 状态码 / 错误率 / 流量 / 路径表 ----
// 行布局（_ls_parse）：[0]=ip [1]=path [2]=status [3]=bytes
var pv = arr_len(parsed);
var status_dist = data##group_count(parsed, 2);
var path_dist = data##group_count(parsed, 1);

var uniq = arr_new();
var seen_ip = dict_new();
var seen_path = dict_new();
var err4 = 0;
var err5 = 0;
var traffic = 0;
var hot_path = "";
var hot_count = 0;
i = 0;
loop (i < pv) {
    var row = arr_get(parsed, i);
    var path = arr_get(row, 1);
    var status = str_to_int(arr_get(row, 2));
    traffic += str_to_int(arr_get(row, 3));
    if (status >= 500) {
        err5 += 1;
    } else {
        if (status >= 400) {
            err4 += 1;
        }
    }
    // UV：独立 IP（seen_ip 与路径去重分簿，键空间互不污染）
    var ip = arr_get(row, 0);
    if (dict_has(seen_ip, ip) == false) {
        dict_set(seen_ip, ip, 1);
    }
    // 路径清单去重
    if (dict_get(path_dist, path) > hot_count) {
        hot_count = dict_get(path_dist, path);
        hot_path = path;
    }
    if (dict_has(seen_path, path) == false) {
        dict_set(seen_path, path, 1);
        arr_push(uniq, path);
    }
    i += 1;
}
var uv = dict_len(seen_ip);
arr_sort(uniq);

// ---- ④ 报告 ----
// 格式纪律：str_format 只用 %d/%s
// str_pad_*、百分号用拼接
var report = arr_new();
arr_push(report, "== logstat 访问日志报告 ==");
arr_push(report, str_format("日志行     : %d（解析失败 %d）", total, bad));
arr_push(report, str_format("PV         : %d", pv));
arr_push(report, str_format("UV         : %d", uv));
arr_push(report, str_format("总流量     : %d bytes", traffic));
arr_push(report, "  4xx / 5xx  : " + int_to_str(err4) + " / " + int_to_str(err5) +
        "（错误率 " + num_to_str((err4 + err5) * 100 / pv, 2) + " %）");
arr_push(report, str_format("最热路径   : %s（%d 次）", hot_path, hot_count));
arr_push(report, "状态码分布 :");
var codes = arr_new();
arr_push(codes, "200"); arr_push(codes, "304");
arr_push(codes, "404"); arr_push(codes, "500");
i = 0;
loop (i < arr_len(codes)) {
    var c = arr_get(codes, i);
    var cnt = 0;
    if (dict_has(status_dist, c)) { cnt = dict_get(status_dist, c); }
    arr_push(report, "  " + str_pad_left(c, 3, " ") + "  " + int_to_str(cnt));
    i += 1;
}
arr_push(report, "路径请求数（字典序）:");
i = 0;
loop (i < arr_len(uniq)) {
    var p = arr_get(uniq, i);
    arr_push(report, "  " + str_pad_right(p, 18, " ") + " " +
             int_to_str(dict_get(path_dist, p)));
    i += 1;
}
arr_push(report, str_format("报告已写入: %s", out_path));
fs##write_lines(out_path, report);

i = 0;
loop (i < arr_len(report)) {
    output(arr_get(report, i));
    i += 1;
}
